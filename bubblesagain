/* =========================================================
   FRIENDS
========================================================= */

function sendFriendRequest(targetId){

    if(targetId===currentUserId) return;

    const me =
        getCurrentUser();

    const target =
        getUser(targetId);

    if(!target) return;

    if(
        me.friends.includes(targetId)
    ){

        toast("Вы уже друзья");
        return;
    }

    if(
        target.friendRequests.includes(
            currentUserId
        )
    ){

        toast("Заявка уже отправлена");
        return;
    }

    target.friendRequests.push(
        currentUserId
    );

    me.sentRequests.push(
        targetId
    );

    saveDB();

    renderProfile(targetId);

    toast(
        "Заявка в друзья отправлена 🫂"
    );
}


function acceptFriend(targetId){

    const me =
        getCurrentUser();

    const target =
        getUser(targetId);

    if(!target) return;

    me.friendRequests =
        me.friendRequests.filter(
            id=>id!==targetId
        );

    me.sentRequests =
        me.sentRequests.filter(
            id=>id!==targetId
        );

    target.sentRequests =
        target.sentRequests.filter(
            id=>id!==currentUserId
        );

    target.friendRequests =
        target.friendRequests.filter(
            id=>id!==currentUserId
        );

    if(!me.friends.includes(targetId)){
        me.friends.push(targetId);
    }

    if(!target.friends.includes(currentUserId)){
        target.friends.push(currentUserId);
    }

    saveDB();

    renderProfile(targetId);

    renderFriends();

    renderRightbar();

    toast(
        "Теперь вы друзья! 🫧"
    );
}


function removeFriend(targetId){

    const me =
        getCurrentUser();

    const target =
        getUser(targetId);

    if(!target) return;

    me.friends =
        me.friends.filter(
            id=>id!==targetId
        );

    target.friends =
        target.friends.filter(
            id=>id!==currentUserId
        );

    saveDB();

    renderProfile(targetId);

    renderFriends();

    renderRightbar();

    toast("Пользователь удалён из друзей");
}


