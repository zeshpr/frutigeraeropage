function conversationKey(a,b){

    return [a,b]
        .sort()
        .join("__");
}


function renderMessages(){

    const list =
        document.getElementById(
            "conversationList"
        );

    if(!list) return;

    const me =
        getCurrentUser();

    const friends =
        me.friends
        .map(getUser)
        .filter(Boolean);

    if(!friends.length){

        list.innerHTML=`

            <div
                style="
                text-align:center;
                color:#8299a2;
                font-size:11px;
                padding:20px 5px">
                Добавь друзей,<br>
                чтобы начать общение.
            </div>
        `;

        return;
    }

    list.innerHTML =
        friends
        .map(friend=>{

            const avatar =
                friend.avatar
                ? `<img src="${friend.avatar}">`
                : friend.gender==="female"
                    ? "♀"
                    : "♂";

            return `

                <div
                    class="
                    conversation
                    ${
                        currentChatUserId===friend.id
                        ? "active"
                        :""
                    }"
                    onclick="openChat('${friend.id}')">

                    <div class="user-avatar"
                         style="
                         width:36px;
                         height:36px;
                         flex-basis:36px">
                        ${avatar}
                    </div>

                    <div class="conversation-info">

                        <strong>
                            ${escapeHTML(friend.username)}
                        </strong>

                        <small>
                            написать сообщение
                        </small>

                    </div>

                </div>
            `;
        })
        .join("");

    if(currentChatUserId){

        renderChat();
    }
}


function openChat(userId){

    const me =
        getCurrentUser();

    if(
        !me.friends.includes(userId)
    ){

        toast("Можно писать только друзьям 🫂");
        return;
    }

    currentChatUserId=userId;

    showView("messages");

    renderMessages();

    renderChat();
}


function renderChat(){

    if(!currentChatUserId) return;

    const target =
        getUser(currentChatUserId);

    if(!target) return;

    const key =
        conversationKey(
            currentUserId,
            target.id
        );

    if(!db.messages[key]){
        db.messages[key]=[];
    }

    document
        .getElementById("chatHeader")
        .textContent =
        "💌 "+target.username;

    const container =
        document.getElementById(
            "chatMessages"
        );

    container.innerHTML="";

    const messages =
        db.messages[key];

    if(!messages.length){

        container.innerHTML=`

            <div class="empty">

                <div class="empty-icon">
                    🫧
                </div>

                <h3>
                    Пока здесь тихо
                </h3>

                <p>
                    Напиши первое сообщение
                    пользователю ${escapeHTML(target.username)}.
                </p>

            </div>
        `;

    }else{

        messages.forEach(message=>{

            const bubble =
                document.createElement("div");

            bubble.className =
                "chat-bubble "+
                (
                    message.userId===currentUserId
                    ? "me"
                    : "them"
                );

            bubble.textContent =
                message.text;

            container.appendChild(bubble);
        });
    }

    const input =
        document.getElementById(
            "messageInput"
        );

    const send =
        document.getElementById(
            "messageSend"
        );

    input.disabled=false;
    send.disabled=false;

    container.scrollTop=
        container.scrollHeight;
}


function sendMessage(){

    if(!currentChatUserId) return;

    const input =
        document.getElementById(
            "messageInput"
        );

    const text =
        input.value.trim();

    if(!text) return;

    const key =
        conversationKey(
            currentUserId,
            currentChatUserId
        );

    if(!db.messages[key]){
        db.messages[key]=[];
    }

    db.messages[key].push({

        id:makeId("message"),

        userId:currentUserId,

        text:text,

        createdAt:Date.now()
    });

    input.value="";

    saveDB();

    renderChat();
}


/* =========================================================
   MUSIC
========================================================= */

function publishMusic(){

    const file =
        document
        .getElementById("musicFile")
        .files[0];

    const title =
        document
        .getElementById("musicTitle")
        .value
        .trim();

    if(!file){

        toast("Выбери аудиофайл 🎵");
        return;
    }

    const reader =
        new FileReader();

    reader.onload=()=>{

        const music={

            id:makeId("music"),

            userId:currentUserId,

            title:
                title ||
                file.name.replace(
                    /\.[^/.]+$/,
                    ""
                ),

            fileName:file.name,

            data:reader.result,

            createdAt:Date.now()
        };

        db.music.push(music);

        saveDB();

        document
            .getElementById("musicFile")
            .value="";

        document
            .getElementById("musicTitle")
            .value="";

        renderMusic();

        renderProfile(currentProfileId);

        toast(
            "Песня опубликована 🎵"
        );
    };

    reader.readAsDataURL(file);
}


function renderMusic(){

    const container =
        document.getElementById(
            "allMusic"
        );

    if(!container) return;

    const music =
        [...db.music]
        .sort(
            (a,b)=>
                b.createdAt-a.createdAt
        );

    if(!music.length){

        container.innerHTML=`

            <div class="empty">

                <div class="empty-icon">
                    🎵
                </div>

                <h3>
                    Здесь пока нет музыки
                </h3>

                <p>
                    Опубликуй первую песню.
                </p>

            </div>
        `;

        return;
    }

    container.innerHTML=
        `<div style="display:grid;gap:9px">
            ${
                music
                .map(
                    item =>
                    musicHTML(item,true)
                )
                .join("")
            }
        </div>`;
}


function musicHTML(music,showUser=true){

    const user =
        getUser(music.userId);

    if(!user) return "";

    return `

        <div class="music-card">

            <div class="music-art">
                💿
            </div>

            <div class="music-info">

                <strong>
                    ${escapeHTML(music.title)}
                </strong>

                <small>
                    ${
                        showUser
                        ? "@"+escapeHTML(user.username)
                        : "published music"
                    }
                </small>

            </div>

            <div class="music-buttons">

                <button
                    onclick="playMusic('${music.id}')">
                    ▶
                </button>

                <button
                    onclick="shareMusic('${music.id}')">
                    ↗
                </button>

            </div>

        </div>

    `;
}


function playMusic(musicId){

    const music =
        db.music.find(
            m=>m.id===musicId
        );

    if(!music) return;

    stopAudio();

    currentAudio =
        new Audio(music.data);

    currentAudio.play();

    currentMusicIndex =
        db.music.findIndex(
            m=>m.id===musicId
        );

    const user =
        getUser(music.userId);

    document
        .getElementById("playerTitle")
        .textContent =
        music.title;

    document
        .getElementById("playerAuthor")
        .textContent =
        "@"+user.username;

    currentAudio.onended=()=>{
        nextTrack();
    };

    toast(
        "Играет: "+music.title+" 🎵"
    );
}


function stopAudio(){

    if(currentAudio){

        currentAudio.pause();

        currentAudio.currentTime=0;

        currentAudio=null;
    }
}


function togglePlayer(){

    if(!currentAudio){

        if(db.music.length){

            playMusic(
                db.music[
                    db.music.length-1
                ].id
            );

        }else{

            toast("Музыки пока нет 🎵");
        }

        return;
    }

    if(currentAudio.paused){

        currentAudio.play();

    }else{

        currentAudio.pause();
    }
}


function previousTrack(){

    if(!db.music.length) return;

    currentMusicIndex--;

    if(currentMusicIndex<0){
        currentMusicIndex=
            db.music.length-1;
    }

    playMusic(
        db.music[currentMusicIndex].id
    );
}


function nextTrack(){

    if(!db.music.length) return;

    currentMusicIndex++;

    if(
        currentMusicIndex>=
        db.music.length
    ){

        currentMusicIndex=0;
    }

    playMusic(
        db.music[currentMusicIndex].id
    );
}


function shareMusic(musicId){

    const music =
        db.music.find(
            m=>m.id===musicId
        );

    if(!music) return;

    const user =
        getUser(music.userId);

    const text =
        "🎵 "+music.title+
        " — @"+user.username+
        " | bubbles";

    if(
        navigator.clipboard &&
        navigator.clipboard.writeText
    ){

        navigator.clipboard.writeText(text);

        toast(
            "Информация о песне скопирована 🫧"
        );

    }else{

        toast(
            "Песню можно поделиться через меню браузера"
        );
    }
}


