    searchTimer=setTimeout(()=>{

        query=query.trim().toLowerCase();

        if(!query){

            showView("home");
            return;
        }

        showView("search");

        const results =
            document.getElementById(
                "searchResults"
            );

        const users =
            db.users.filter(
                user =>
                    user.username
                    .toLowerCase()
                    .includes(query)
            );

        const music =
            db.music.filter(
                item =>
