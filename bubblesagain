<script>

/* =========================================================
   BUBBLES DATA SYSTEM
========================================================= */

const DB_KEY = "BUBBLES_DATABASE_V2";
const SESSION_KEY = "BUBBLES_SESSION_V2";

let db = {
    users: [],
    posts: [],
    music: [],
    messages: {}
};

let currentUserId = null;
let currentProfileId = null;
let currentChatUserId = null;
let currentAudio = null;
let currentMusicIndex = -1;
let pendingAvatar = null;
let pendingCover = null;


/* =========================================================
   DATABASE
========================================================= */

function loadDB(){

    try{

        const saved =
            localStorage.getItem(DB_KEY);

        if(saved){
            db = JSON.parse(saved);
        }

        if(!db.users) db.users=[];
        if(!db.posts) db.posts=[];
        if(!db.music) db.music=[];
        if(!db.messages) db.messages={};

    }catch(error){

        console.error(error);

        db={
            users:[],
            posts:[],
            music:[],
            messages:{}
        };
    }
}


function saveDB(){

    try{

        localStorage.setItem(
            DB_KEY,
            JSON.stringify(db)
        );

        return true;

    }catch(error){

        console.error(error);

        toast(
            "Браузер не смог сохранить данные. Возможно, закончилась память."
        );

        return false;
    }
}


function getCurrentUser(){

    return db.users.find(
        u => u.id === currentUserId
    );
}


function getUser(id){

    return db.users.find(
        u => u.id === id
    );
}


function makeId(prefix="id"){

    return prefix + "_" +
        Date.now().toString(36) +
        "_" +
        Math.random().toString(36).slice(2,9);
}


/* =========================================================
   STARTUP
========================================================= */

document.addEventListener("DOMContentLoaded",()=>{

    createBackgroundBubbles();

    loadDB();

    const session =
        localStorage.getItem(SESSION_KEY);

    if(session){

        const user =
            getUser(session);

        if(user){

            currentUserId = user.id;

            openApp();

        }else{

            localStorage.removeItem(SESSION_KEY);
        }
    }

});


function createBackgroundBubbles(){

    const container =
        document.getElementById("backgroundBubbles");

    for(let i=0;i<20;i++){

        const bubble =
            document.createElement("div");

        bubble.className="bg-bubble";

        const size =
            Math.floor(Math.random()*50)+12;

        bubble.style.width=size+"px";
        bubble.style.height=size+"px";
        bubble.style.left=Math.random()*100+"%";

        bubble.style.animationDuration =
            (12+Math.random()*17)+"s";

        bubble.style.animationDelay =
            (-Math.random()*20)+"s";

        container.appendChild(bubble);
    }
}


/* =========================================================
   AUTH
========================================================= */

function switchAuth(type){

    const login =
        document.getElementById("loginForm");

    const register =
        document.getElementById("registerForm");

    const loginTab =
        document.getElementById("loginTab");

    const registerTab =
        document.getElementById("registerTab");

    if(type==="login"){

        login.classList.remove("hidden");
        register.classList.add("hidden");

        loginTab.classList.add("active");
        registerTab.classList.remove("active");

    }else{

        login.classList.add("hidden");
        register.classList.remove("hidden");

        loginTab.classList.remove("active");
        registerTab.classList.add("active");
    }
}


function register(event){

    event.preventDefault();

    const username =
        document
        .getElementById("registerUsername")
        .value
        .trim();

    const password =
        document
        .getElementById("registerPassword")
        .value;

    const bio =
        document
        .getElementById("registerBio")
        .value
        .trim();

    const gender =
        document.querySelector(
            'input[name="registerGender"]:checked'
        );

    if(username.length<2){

        toast("Юзернейм слишком короткий 🫧");
        return;
    }

    if(!/^[a-zA-Z0-9_.-]+$/.test(username)){

        toast(
            "Используй только латинские буквы, цифры, _ . или -"
        );

        return;
    }

    if(password.length<4){

        toast("Пароль должен быть минимум 4 символа");
        return;
    }

    if(!gender){

        toast("Выбери пол профиля");
        return;
    }

    const exists =
        db.users.some(
            u =>
                u.username.toLowerCase() ===
                username.toLowerCase()
        );

    if(exists){

        toast("Такой юзернейм уже занят");
        return;
    }

    const user={

        id:makeId("user"),

        username:username,

        password:password,

        gender:gender.value,

        bio:bio,

        avatar:"",

        cover:"",

        friends:[],

        friendRequests:[],

        sentRequests:[],

        createdAt:Date.now()
    };

    db.users.push(user);

    if(!saveDB()) return;

    currentUserId=user.id;

    localStorage.setItem(
        SESSION_KEY,
        user.id
    );

    openApp();

    toast(
        "Добро пожаловать в bubbles! 🫧"
    );
}


function login(event){

    event.preventDefault();

    const username =
        document
        .getElementById("loginUsername")
        .value
        .trim();

    const password =
        document
        .getElementById("loginPassword")
        .value;

    const user =
        db.users.find(
            u =>
                u.username.toLowerCase() ===
                username.toLowerCase() &&
                u.password === password
        );

    if(!user){

        toast(
            "Неверный юзернейм или пароль"
        );

        return;
    }

    currentUserId=user.id;

    localStorage.setItem(
        SESSION_KEY,
        user.id
    );

    openApp();
}


function logout(){

    stopAudio();

    currentUserId=null;
    currentProfileId=null;
    currentChatUserId=null;

    localStorage.removeItem(
        SESSION_KEY
    );

    document
        .getElementById("app")
        .classList.add("hidden");

    document
        .getElementById("auth")
        .classList.remove("hidden");

    document
        .getElementById("loginForm")
        .reset();

    toast("До встречи в bubbles 🫧");
}


