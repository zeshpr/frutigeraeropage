/* =========================================================
   NAVIGATION
========================================================= */

function showView(name){

    document
        .querySelectorAll(".view")
        .forEach(
            view =>
                view.classList.remove("active")
        );

    const target =
        document.getElementById(
            "view-"+name
        );

    if(target){
        target.classList.add("active");
    }

    document
        .querySelectorAll(".nav button[data-view]")
        .forEach(btn=>{
            btn.classList.toggle(
                "active",
                btn.dataset.view===name
            );
        });

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });

    if(name==="friends"){
        renderFriends();
    }

    if(name==="messages"){
        renderMessages();
    }

    if(name==="music"){
        renderMusic();
    }

    if(name==="home"){
        renderFeed();
    }
}


function openOwnProfile(){

    openProfile(currentUserId);
}


function openProfile(id){

    currentProfileId=id;

    renderProfile(id);

    showView("profile");
}


/* =========================================================
   POSTS
========================================================= */

function createPost(){

    const text =
        document
        .getElementById("postText")
        .value
        .trim();

    const imageInput =
        document.getElementById("postImage");

    const file =
        imageInput.files[0];

    if(!text && !file){

        toast("Напиши что-нибудь или добавь фото 🫧");
        return;
    }

    if(file){

        const reader =
            new FileReader();

        reader.onload=()=>{

            addPost(
                text,
                reader.result
            );
        };

        reader.readAsDataURL(file);

    }else{

        addPost(text,"");
    }
}


function addPost(text,image){

    const post={

        id:makeId("post"),

        userId:currentUserId,

        text:text,

        image:image,

        likes:[],

        comments:[],

        createdAt:Date.now()
    };

    db.posts.unshift(post);

    if(!saveDB()) return;

    document
        .getElementById("postText")
        .value="";

    document
        .getElementById("postImage")
        .value="";

    renderFeed();

    toast("Пост опубликован 🫧");
}


function renderFeed(){

    const feed =
        document.getElementById("feed");

    if(!feed) return;

    feed.innerHTML="";

    const posts =
        [...db.posts]
        .sort(
            (a,b)=>
                b.createdAt-a.createdAt
        );

    if(!posts.length){

        feed.innerHTML=`

            <div class="panel empty">

                <div class="empty-icon">
                    🫧
                </div>

                <h3>
                    Лента пока пустая
                </h3>

                <p>
                    Здесь будут появляться посты.
                    Напиши что-нибудь первым!
                </p>

            </div>

        `;

        return;
    }

    posts.forEach(post=>{

        feed.appendChild(
            createPostElement(post)
        );
    });
}


function createPostElement(post){

    const user =
        getUser(post.userId);

    if(!user) return document.createElement("div");

    const article =
        document.createElement("article");

    article.className="panel post";

    const liked =
        post.likes.includes(currentUserId);

    const avatar =
        user.avatar
        ? `<img src="${user.avatar}">`
        : user.gender==="female"
            ? "♀"
            : "♂";

    const comments =
        post.comments || [];

    article.innerHTML=`

        <div class="post-header">

            <div
                class="user-avatar"
                onclick="openProfile('${user.id}')"
                style="cursor:pointer">

                ${avatar}

            </div>

            <div
                class="post-user"
                onclick="openProfile('${user.id}')"
                style="cursor:pointer">

                <strong>
                    ${escapeHTML(user.username)}
                </strong>

                <small>
                    ${formatDate(post.createdAt)}
                </small>

            </div>

            ${
                post.userId===currentUserId
                ? `
                    <button
                        class="post-menu"
                        onclick="deletePost('${post.id}')">
                        🗑
                    </button>
                `
                :""
            }

        </div>

        ${
            post.text
            ? `
                <div class="post-text">
                    ${escapeHTML(post.text)}
                </div>
            `
            :""
        }

        ${
            post.image
            ? `
                <img
                    class="post-image"
                    src="${post.image}">
            `
            :""
        }

        <div class="post-actions">

            <button
                class="${liked?"liked":""}"
                onclick="toggleLike('${post.id}')">

                ${liked?"♥":"♡"}
                ${post.likes.length}

            </button>

            <button
                onclick="focusComment('${post.id}')">
                💬 ${comments.length}
            </button>

            <button
                onclick="sharePost('${post.id}')">
                ↗ Поделиться
            </button>

            <button
                onclick="openProfile('${user.id}')">
                👤 Профиль
            </button>

        </div>

        <div
            class="comments"
            id="comments-${post.id}">

            ${
                comments
                .map(
                    comment =>
                    createCommentHTML(comment)
                )
                .join("")
            }

        </div>

        <div class="comment-box">

            <input
                id="comment-${post.id}"
                placeholder="оставить комментарий..."
                onkeydown="
                    if(event.key==='Enter')
                    addComment('${post.id}')
                ">

            <button
                onclick="addComment('${post.id}')">
                →
            </button>

        </div>

    `;

    return article;
}


function createCommentHTML(comment){

    const user =
        getUser(comment.userId);

    if(!user) return "";

    return `

        <div class="comment">

            <strong>
                ${escapeHTML(user.username)}
            </strong>

            ${escapeHTML(comment.text)}

        </div>

    `;
}


function toggleLike(postId){

    const post =
        db.posts.find(
            p=>p.id===postId
        );

    if(!post) return;

    const index =
        post.likes.indexOf(currentUserId);

    if(index===-1){

        post.likes.push(
            currentUserId
        );

    }else{

        post.likes.splice(
            index,
            1
        );
    }

    saveDB();

    renderFeed();
}


function addComment(postId){

    const input =
        document.getElementById(
            "comment-"+postId
        );

    if(!input) return;

    const text =
        input.value.trim();

    if(!text) return;

    const post =
        db.posts.find(
            p=>p.id===postId
        );

    if(!post) return;

    if(!post.comments){
        post.comments=[];
    }

    post.comments.push({

        id:makeId("comment"),

        userId:currentUserId,

        text:text,

        createdAt:Date.now()
    });

    saveDB();

    renderFeed();
}


function focusComment(postId){

    const input =
        document.getElementById(
            "comment-"+postId
        );

    if(input){

        input.focus();

        input.scrollIntoView({
            behavior:"smooth",
            block:"center"
        });
    }
}


function deletePost(postId){

    const post =
        db.posts.find(
            p=>p.id===postId
        );

    if(!post) return;

    if(post.userId!==currentUserId){
        return;
    }

    if(!confirm("Удалить этот пост?")){
        return;
    }

    db.posts =
        db.posts.filter(
            p=>p.id!==postId
        );

    saveDB();

    renderFeed();

    toast("Пост удалён");
}


function sharePost(postId){

    const post =
        db.posts.find(
            p=>p.id===postId
        );

    if(!post) return;

    const text =
        post.text
        ? "🫧 "+post.text
        : "🫧 Посмотри этот пост в bubbles!";

    if(
        navigator.clipboard &&
        navigator.clipboard.writeText
    ){

        navigator.clipboard.writeText(text);

        toast("Текст поста скопирован 🫧");

    }else{

        toast("Пост можно переслать из меню браузера");
    }
}


