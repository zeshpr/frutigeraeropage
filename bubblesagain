        );

    avatarPreview.innerHTML =
        user.avatar
        ? `<img src="${user.avatar}">`
        : user.gender==="female"
            ? "♀"
            : "♂";

    const coverPreview =
        document.getElementById(
            "coverPreview"
        );

    coverPreview.style.backgroundImage =
        user.cover
        ? `url("${user.cover}")`
        : "";
}


function saveProfileSettings(){

    const user =
        getCurrentUser();

    const username =
        document
        .getElementById("editUsername")
        .value
        .trim();

    const bio =
        document
        .getElementById("editBio")
        .value
        .trim();

    if(username.length<2){

        toast("Юзернейм слишком короткий");
        return;
    }

    if(!/^[a-zA-Z0-9_.-]+$/.test(username)){

        toast(
            "Юзернейм может содержать только латиницу, цифры, _ . -"
        );

        return;
    }

    const duplicate =
        db.users.some(
            other =>
                other.id!==user.id &&
                other.username.toLowerCase()===
                username.toLowerCase()
        );

    if(duplicate){

        toast("Этот юзернейм уже занят");
        return;
    }

    user.username=username;
    user.bio=bio;

    saveDB();

    updateSidebar();

    renderProfile(currentProfileId);

    renderFeed();

    renderFriends();

    renderMessages();

    toast(
        "Профиль сохранён 🫧"
    );
}


