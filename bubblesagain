<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>BUBBLES — social network</title>

<style>
*{box-sizing:border-box}

:root{
    --blue:#42b9df;
    --blue2:#168fc1;
    --cyan:#bdf6ff;
    --green:#8ee2a4;
    --text:#315d6d;
    --muted:#78939e;
    --glass:rgba(255,255,255,.68);
    --glass2:rgba(255,255,255,.48);
    --line:rgba(255,255,255,.95);
    --shadow:0 12px 35px rgba(36,126,157,.20);
    --radius:24px;
}

html,body{
    margin:0;
    min-height:100%;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    color:var(--text);
    background:
        radial-gradient(circle at 8% 12%,rgba(255,255,255,.9) 0 35px,transparent 36px),
        radial-gradient(circle at 87% 25%,rgba(255,255,255,.65) 0 65px,transparent 66px),
        radial-gradient(circle at 65% 90%,rgba(255,255,255,.5) 0 80px,transparent 81px),
        linear-gradient(180deg,#62d3ef 0%,#b9f4f6 48%,#dfffd9 100%);
    background-attachment:fixed;
    overflow-x:hidden;
}

button,input,textarea,select{
    font:inherit;
}

button{
    cursor:pointer;
}

button:disabled{
    cursor:default;
    opacity:.55;
}

img{
    max-width:100%;
}

.hidden{
    display:none!important;
}

/* ---------------- BACKGROUND ---------------- */

.background-bubbles{
    position:fixed;
    inset:0;
    overflow:hidden;
    pointer-events:none;
    z-index:0;
}

.bg-bubble{
    position:absolute;
    bottom:-100px;
    border-radius:50%;
    border:1px solid rgba(255,255,255,.85);
    background:linear-gradient(
        135deg,
        rgba(255,255,255,.8),
        rgba(255,255,255,.12)
    );
    box-shadow:
        inset 5px 5px 12px rgba(255,255,255,.8),
        0 4px 15px rgba(50,140,170,.08);
    animation:floatBubble linear infinite;
}

@keyframes floatBubble{
    from{
        transform:translateY(0) translateX(0);
        opacity:0;
    }
    10%{opacity:.7}
    90%{opacity:.5}
    to{
        transform:translateY(-120vh) translateX(60px);
        opacity:0;
    }
}

/* ---------------- AUTH ---------------- */

#auth{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:20px;
    position:relative;
    z-index:5;
}

.auth-card{
    width:min(470px,100%);
    padding:34px;
    border:2px solid var(--line);
    border-radius:34px;
    background:rgba(255,255,255,.65);
    box-shadow:
        inset 0 2px 0 #fff,
        0 25px 65px rgba(23,112,145,.25);
    backdrop-filter:blur(20px);
}

.logo{
    text-align:center;
    color:#fff;
    font-size:60px;
    font-weight:900;
    letter-spacing:-5px;
    text-shadow:
        0 3px 0 #38a5cc,
        0 8px 18px rgba(26,111,145,.35);
}

.logo-sub{
    text-align:center;
    margin-top:-5px;
    margin-bottom:28px;
    color:#36778c;
    font-weight:bold;
}

.auth-tabs{
    display:flex;
    gap:6px;
    padding:5px;
    background:rgba(255,255,255,.45);
    border-radius:17px;
    margin-bottom:18px;
}

.auth-tabs button{
    flex:1;
    border:0;
    padding:11px;
    border-radius:13px;
    background:transparent;
    color:#36758a;
    font-weight:bold;
}

.auth-tabs button.active{
    background:#fff;
    box-shadow:0 4px 12px rgba(25,120,150,.12);
}

.field{
    margin-bottom:14px;
}

.field label{
    display:block;
    margin:0 0 6px 5px;
    font-size:13px;
    font-weight:bold;
}

.field input,
.field textarea,
.field select{
    width:100%;
    padding:12px 14px;
    border:1px solid #fff;
    border-radius:15px;
    outline:none;
    color:var(--text);
    background:rgba(255,255,255,.75);
    box-shadow:inset 0 2px 5px rgba(30,120,150,.06);
}

.field textarea{
    resize:vertical;
}

.gender-row{
    display:flex;
    gap:9px;
}

.gender-row label{
    flex:1;
    margin:0;
}

.gender-row input{
    display:none;
}

.gender-row span{
    display:block;
    padding:11px;
    text-align:center;
    border-radius:15px;
    background:rgba(255,255,255,.48);
    border:1px solid transparent;
}

.gender-row input:checked+span{
    background:#fff;
    border-color:#4dbbdb;
}

.primary{
    width:100%;
    padding:13px;
    border:1px solid #fff;
    border-radius:17px;
    color:#fff;
    font-weight:900;
    background:linear-gradient(#76dcf0,#28a7d4);
    box-shadow:
        inset 0 2px 0 rgba(255,255,255,.75),
        0 6px 15px rgba(25,125,160,.2);
    transition:.2s;
}

.primary:hover{
    transform:translateY(-1px);
}

.auth-note{
    text-align:center;
    margin-top:13px;
    font-size:11px;
    color:#668792;
}

/* ---------------- APP ---------------- */

#app{
    position:relative;
    z-index:2;
    min-height:100vh;
}

.topbar{
    position:sticky;
    top:10px;
    z-index:50;
    width:min(1250px,calc(100% - 20px));
    min-height:67px;
    margin:10px auto;
    padding:9px 12px;
    display:flex;
    align-items:center;
    gap:12px;
    border:1px solid #fff;
    border-radius:24px;
    background:rgba(255,255,255,.7);
    box-shadow:var(--shadow);
    backdrop-filter:blur(18px);
}

.brand{
    color:#fff;
    font-size:31px;
    font-weight:900;
    letter-spacing:-2px;
    text-shadow:0 2px 0 #42a9cb;
    padding:0 10px;
}

.search-wrap{
    flex:1;
    position:relative;
}

.search-wrap input{
    width:100%;
    border:0;
    outline:0;
    border-radius:17px;
    padding:12px 16px;
    color:var(--text);
    background:rgba(255,255,255,.65);
}

.header-actions{
    display:flex;
    gap:6px;
}

.icon-btn{
    width:42px;
    height:42px;
    border:1px solid #fff;
    border-radius:14px;
    background:rgba(255,255,255,.68);
    color:#34778b;
    transition:.18s;
}

.icon-btn:hover{
    transform:translateY(-2px);
}

.layout{
    width:min(1250px,calc(100% - 20px));
    margin:18px auto 40px;
    display:grid;
    grid-template-columns:205px minmax(0,1fr) 235px;
    gap:16px;
}

.panel{
    border:1px solid #fff;
    border-radius:var(--radius);
    background:var(--glass);
    box-shadow:var(--shadow);
    backdrop-filter:blur(15px);
    overflow:hidden;
}

.panel-inner{
    padding:15px;
}

.sidebar-avatar{
    width:78px;
    height:78px;
    margin:0 auto 9px;
    border:4px solid #fff;
    border-radius:50%;
    overflow:hidden;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(145deg,#8beaf8,#51b9dd);
    box-shadow:0 6px 15px rgba(20,120,150,.2);
    font-size:32px;
}

.sidebar-avatar img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.sidebar-name{
    text-align:center;
    font-size:17px;
    font-weight:900;
}

.online{
    text-align:center;
    color:#658a96;
    font-size:11px;
    margin:3px 0 15px;
}

.online-dot{
    display:inline-block;
    width:8px;
    height:8px;
    border-radius:50%;
    background:#43c979;
    box-shadow:0 0 7px #43c979;
}

.nav{
    display:grid;
    gap:5px;
}

.nav button{
    width:100%;
    padding:10px 11px;
    border:0;
    border-radius:14px;
    text-align:left;
    background:transparent;
    color:#316f82;
    font-weight:bold;
}

.nav button:hover,
.nav button.active{
    background:#fff;
    box-shadow:0 4px 12px rgba(25,120,150,.1);
}

.nav button span{
    display:inline-block;
    width:25px;
}

.sidebar-box{
    margin-top:15px;
    padding:11px;
    border-radius:16px;
    background:rgba(220,255,224,.5);
    font-size:11px;
}

.logout{
    margin-top:9px!important;
    color:#56808c!important;
}

/* ---------------- VIEWS ---------------- */

.view{
    display:none;
}

.view.active{
    display:block;
}

/* ---------------- HOME ---------------- */

.welcome{
    min-height:190px;
    padding:25px;
    position:relative;
    overflow:hidden;
    background:
        radial-gradient(circle at 82% 25%,rgba(255,255,255,.85) 0 28px,transparent 29px),
        radial-gradient(circle at 91% 75%,rgba(255,255,255,.55) 0 55px,transparent 56px),
        linear-gradient(135deg,#4bc8e9,#b5f0ef 58%,#aee6a9);
}

.welcome h1{
    margin:0;
    color:#fff;
    font-size:31px;
    text-shadow:0 2px 0 #44a4c5;
}

.welcome p{
    max-width:580px;
    margin:10px 0;
    color:#34798b;
    font-weight:bold;
    line-height:1.5;
}

.welcome-bubbles{
    position:absolute;
    right:25px;
    bottom:20px;
    display:flex;
    align-items:flex-end;
    gap:6px;
}

.welcome-bubbles span{
    width:25px;
    height:25px;
    display:block;
    border-radius:50%;
    border:1px solid #fff;
    background:linear-gradient(135deg,#fff,rgba(255,255,255,.12));
    box-shadow:inset 4px 4px 8px #fff;
}

.welcome-bubbles span:nth-child(2){
    width:60px;
    height:60px;
}

.welcome-bubbles span:nth-child(3){
    width:34px;
    height:34px;
}

.page-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:16px 17px 0;
}

.page-head h2{
    margin:0;
    font-size:19px;
}

.page-body{
    padding:15px;
}

.section{
    margin-top:15px;
}

/* ---------------- POST CREATOR ---------------- */

.composer{
    padding:15px;
}

.composer-top{
    display:flex;
    gap:10px;
}

.composer-avatar{
    width:43px;
    height:43px;
    flex:0 0 43px;
    overflow:hidden;
    border:2px solid #fff;
    border-radius:50%;
    background:linear-gradient(135deg,#6ed8ec,#8bdca2);
    display:flex;
    align-items:center;
    justify-content:center;
}

.composer-avatar img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.composer textarea{
    width:100%;
    min-height:75px;
    resize:vertical;
    border:1px solid #fff;
    outline:none;
    border-radius:17px;
    padding:12px;
    color:var(--text);
    background:rgba(255,255,255,.65);
}

.composer-bottom{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:8px;
    margin-top:9px;
}

.file-btn{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:9px 12px;
    border:1px solid #fff;
    border-radius:13px;
    background:rgba(255,255,255,.65);
    color:#397588;
    font-size:12px;
    font-weight:bold;
    cursor:pointer;
}

.file-btn input{
    display:none;
}

.post-btn{
    padding:10px 17px;
    border:1px solid #fff;
    border-radius:14px;
    background:linear-gradient(#78ddf0,#39add3);
    color:#fff;
    font-weight:900;
}

/* ---------------- POSTS ---------------- */

.feed{
    display:grid;
    gap:14px;
    margin-top:15px;
}

.post{
    padding:15px;
}

.post-header{
    display:flex;
    align-items:center;
    gap:10px;
}

.user-avatar{
    width:44px;
    height:44px;
    flex:0 0 44px;
    border:2px solid #fff;
    border-radius:50%;
    overflow:hidden;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(135deg,#7cdeef,#8adca2);
}

.user-avatar img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.post-user{
    flex:1;
}

.post-user strong{
    display:block;
    font-size:14px;
}

.post-user small{
    color:#8198a0;
    font-size:10px;
}

.post-menu{
    border:0;
    background:transparent;
    color:#79949d;
}

.post-text{
    margin:13px 2px;
    white-space:pre-wrap;
    line-height:1.5;
    font-size:14px;
}

.post-image{
    width:100%;
    max-height:600px;
    object-fit:cover;
    border:1px solid #fff;
    border-radius:18px;
    display:block;
}

.post-actions{
    display:flex;
    gap:5px;
    margin-top:11px;
    padding-top:9px;
    border-top:1px solid rgba(80,160,180,.12);
}

.post-actions button{
    border:0;
    border-radius:12px;
    padding:8px 11px;
    background:rgba(255,255,255,.5);
    color:#497887;
    font-size:12px;
    font-weight:bold;
}

.post-actions button:hover{
    background:#fff;
}

.post-actions button.liked{
    color:#e25c9c;
    background:#fff;
}

.comments{
    margin-top:10px;
    display:grid;
    gap:6px;
}

.comment{
    padding:8px 10px;
    border-radius:12px;
    background:rgba(255,255,255,.4);
    font-size:12px;
}

.comment strong{
    margin-right:4px;
}

.comment-box{
    display:flex;
    gap:6px;
    margin-top:8px;
}

.comment-box input{
    flex:1;
    border:1px solid #fff;
    outline:none;
    border-radius:12px;
    padding:9px;
    background:rgba(255,255,255,.6);
    color:var(--text);
}

.comment-box button{
    border:1px solid #fff;
    border-radius:12px;
    background:#fff;
    color:#347489;
}

/* ---------------- EMPTY ---------------- */

.empty{
    padding:40px 20px;
    text-align:center;
    border:2px dashed rgba(60,150,180,.25);
    border-radius:19px;
    background:rgba(255,255,255,.22);
}

.empty-icon{
    font-size:40px;
}

.empty h3{
    margin:6px 0;
}

.empty p{
    max-width:450px;
    margin:5px auto;
    color:#72909a;
    font-size:12px;
    line-height:1.5;
}

/* ---------------- PROFILE ---------------- */

.profile-cover{
    height:235px;
    position:relative;
    background:
        radial-gradient(circle at 20% 25%,rgba(255,255,255,.8) 0 35px,transparent 36px),
        radial-gradient(circle at 75% 70%,rgba(255,255,255,.5) 0 65px,transparent 66px),
        linear-gradient(135deg,#50c8e7,#b5f1ef 55%,#a6e4a5);
    background-size:cover;
    background-position:center;
}

.profile-cover::after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(
        transparent 45%,
        rgba(0,100,130,.08)
    );
}

.profile-avatar-large{
    position:absolute;
    z-index:2;
    left:25px;
    bottom:-52px;
    width:120px;
    height:120px;
    border:5px solid #fff;
    border-radius:50%;
    overflow:hidden;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(145deg,#91ecf8,#4bb8dc);
    box-shadow:0 9px 20px rgba(25,120,150,.25);
    font-size:50px;
}

.profile-avatar-large img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.profile-details{
    padding:65px 25px 20px;
}

.profile-name{
    font-size:29px;
    font-weight:900;
}

.profile-username{
    color:#78939e;
    font-size:13px;
    margin-top:2px;
}

.profile-bio{
    margin-top:8px;
    max-width:700px;
    line-height:1.45;
    font-size:13px;
}

.profile-actions{
    display:flex;
    gap:8px;
    margin-top:15px;
    flex-wrap:wrap;
}

.small-primary,
.small-button{
    padding:9px 13px;
    border:1px solid #fff;
    border-radius:13px;
    font-weight:bold;
    font-size:12px;
}

.small-primary{
    background:linear-gradient(#74dbee,#34a9d1);
    color:#fff;
}

.small-button{
    background:rgba(255,255,255,.7);
    color:#3d7485;
}

.profile-stats{
    display:flex;
    flex-wrap:wrap;
    gap:7px;
    margin-top:14px;
}

.stat{
    padding:7px 10px;
    border:1px solid #fff;
    border-radius:12px;
    background:rgba(255,255,255,.5);
    font-size:11px;
    font-weight:bold;
}

/* ---------------- FRIENDS ---------------- */

.user-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:10px;
}

.user-card{
    display:flex;
    align-items:center;
    gap:10px;
    padding:11px;
    border:1px solid #fff;
    border-radius:17px;
    background:rgba(255,255,255,.48);
}

.user-card-info{
    flex:1;
    min-width:0;
}

.user-card-info strong{
    display:block;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.user-card-info small{
    color:#7c969f;
    font-size:10px;
}

.user-card button{
    border:1px solid #fff;
    border-radius:10px;
    background:#fff;
    color:#36768a;
    padding:7px 9px;
    font-size:11px;
}

/* ---------------- MESSAGES ---------------- */

.messages-layout{
    display:grid;
    grid-template-columns:180px 1fr;
    min-height:520px;
}

.conversations{
    border-right:1px solid rgba(60,140,160,.13);
    padding:10px;
}

.conversation{
    display:flex;
    align-items:center;
    gap:8px;
    padding:9px;
    border-radius:13px;
    cursor:pointer;
}

.conversation:hover,
.conversation.active{
    background:#fff;
}

.conversation-info{
    min-width:0;
}

.conversation-info strong{
    display:block;
    font-size:12px;
}

.conversation-info small{
    display:block;
    color:#8aa0a8;
    font-size:9px;
}

.chat{
    display:flex;
    flex-direction:column;
    min-width:0;
}

.chat-header{
    padding:14px;
    border-bottom:1px solid rgba(60,140,160,.13);
    font-weight:900;
}

.chat-messages{
    flex:1;
    min-height:380px;
    max-height:500px;
    overflow:auto;
    padding:15px;
    display:flex;
    flex-direction:column;
    gap:7px;
}

.chat-bubble{
    max-width:72%;
    padding:9px 12px;
    border-radius:15px;
    font-size:12px;
}

.chat-bubble.me{
    align-self:flex-end;
    color:#fff;
    background:linear-gradient(#6bd4eb,#3ba9d0);
}

.chat-bubble.them{
    align-self:flex-start;
    background:#fff;
}

.chat-input{
    display:flex;
    gap:6px;
    padding:10px;
    border-top:1px solid rgba(60,140,160,.13);
}

.chat-input input{
    flex:1;
    border:1px solid #fff;
    outline:none;
    border-radius:13px;
    padding:10px;
    background:rgba(255,255,255,.6);
    color:var(--text);
}

.chat-input button{
    border:1px solid #fff;
    border-radius:13px;
    background:#fff;
    color:#36778a;
    padding:0 13px;
}

/* ---------------- MUSIC ---------------- */

.music-card{
    display:flex;
    align-items:center;
    gap:11px;
    padding:11px;
    border:1px solid #fff;
    border-radius:17px;
    background:rgba(255,255,255,.5);
}

.music-art{
    width:53px;
    height:53px;
    flex:0 0 53px;
    border-radius:15px;
    border:1px solid #fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:25px;
    background:
        radial-gradient(circle at 25% 20%,#fff 0 5px,transparent 6px),
        linear-gradient(135deg,#65d7ed,#72d6a4);
}

.music-info{
    flex:1;
    min-width:0;
}

.music-info strong{
    display:block;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.music-info small{
    display:block;
    margin-top:3px;
    color:#7d969f;
    font-size:10px;
}

.music-buttons{
    display:flex;
    gap:4px;
}

.music-buttons button{
    border:1px solid #fff;
    border-radius:10px;
    background:#fff;
    color:#39778a;
    padding:7px 8px;
}

/* ---------------- RIGHT ---------------- */

.right-player{
    padding:12px;
}

.cover-small{
    height:115px;
    border:1px solid #fff;
    border-radius:17px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:35px;
    background:
        radial-gradient(circle at 25% 20%,#fff 0 7px,transparent 8px),
        linear-gradient(135deg,#65d8ee,#78d8a5);
}

.now-playing{
    margin-top:8px;
    font-size:13px;
    font-weight:900;
}

.now-meta{
    margin-top:2px;
    color:#8198a0;
    font-size:10px;
}

.player-buttons{
    display:flex;
    justify-content:center;
    gap:6px;
    margin-top:9px;
}

